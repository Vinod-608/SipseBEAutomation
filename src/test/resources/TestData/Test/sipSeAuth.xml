<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SipSe Auth Test Suite" verbose="1" parallel="none">

    <parameter name="dbServer" value="jarfin"/>

    <listeners>
        <listener class-name="org.jarfinApiBackendAutomation.listeners.Listeners"/>
        <listener class-name="org.jarfinApiBackendAutomation.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="SipSe Auth Tests">
        <classes>
            <class name="sipSe.authLogin.SipSeAuthTest"/>
            <class name="sipSe.onBoarding.OnboardingTest"/>
            <class name="sipSe.kycFlow.UserKycTest"></class>
        </classes>
    </test>

</suite>
