<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SipSe Withdrawl Test Suite" verbose="1" data-provider-thread-count="7">

    <parameter name="dbServer" value="jarfin"/>

    <listeners>
        <listener class-name="org.jarfinApiBackendAutomation.listeners.Listeners"/>
        <listener class-name="org.jarfinApiBackendAutomation.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="SipSe Withdrawl Tests" preserve-order="true">
        <classes>
            <class name="sipSe.withdrawl.WithdrawlTest">
                <methods>
                    <include name="HomeFeedMetaData"/>
                    <include name="lockerScreenDetails"/>
                    <include name="schemeWiseBalance"/>
                    <include name="schemeFolioBalance"/>
                    <include name="preRedemptionSummary"/>
                    <include name="withdrawlInitiate"/>
                    <include name="withdrawlSubmit"/>
                    <include name="withdrawlStatus"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
