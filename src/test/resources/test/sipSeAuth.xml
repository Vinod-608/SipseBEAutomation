<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SipSe Auth Test Suite" verbose="1" data-provider-thread-count="7">

    <parameter name="dbServer" value="jarfin"/>

    <listeners>
        <listener class-name="org.jarfinApiBackendAutomation.listeners.Listeners"/>
        <listener class-name="org.jarfinApiBackendAutomation.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="SipSe Auth Tests" preserve-order="true">
        <classes>
            <class name="sipSe.authLogin.SipSeAuthTest">
                <methods>
                    <include name="requestOtp"/>
                    <include name="fetchOtpFromDb"/>
                    <include name="verifyOtp"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
